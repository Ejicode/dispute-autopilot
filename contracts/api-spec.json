{
  "openapi": "3.1.0",
  "info": {
    "title": "Dispute Autopilot REST API",
    "version": "1.0.0",
    "description": "API Specification for Dispute Autopilot - AI agent that handles PayPal disputes for sellers safely"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/disputes": {
      "get": {
        "summary": "List disputes with triage scores, risk metrics and deadlines",
        "responses": {
          "200": {
            "description": "Array of disputes sorted by money at risk and deadline",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "./schemas/dispute.schema.json"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a simulated dispute in demo mode only",
        "security": [
          {
            "merchantSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Simulated dispute and draft"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Simulation disabled outside demo mode or Origin denied"
          }
        }
      }
    },
    "/api/disputes/{id}": {
      "get": {
        "summary": "Get single dispute detail with evidence items, draft, and audit timeline",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dispute packet detail"
          },
          "404": {
            "description": "Dispute not found"
          }
        }
      }
    },
    "/api/disputes/{id}/verify-draft": {
      "post": {
        "summary": "Execute deterministic code verification on an AI draft against vault evidence",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result with verified boolean, claims, and errors"
          },
          "400": {
            "description": "Malformed body or attempted claims override"
          },
          "401": {
            "description": "Session required"
          },
          "404": {
            "description": "Dispute or draft not found"
          }
        },
        "security": [
          {
            "merchantSession": []
          }
        ]
      }
    },
    "/api/disputes/{id}/approve": {
      "post": {
        "summary": "Human approval gate executing exact action via PayPal Disputes API with idempotency",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/approval_request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider acknowledgement, or saved result of the same operation"
          },
          "202": {
            "description": "Same operation already submitting; no duplicate call"
          },
          "400": {
            "description": "Malformed body, invalid action/digest, or unsupported fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin or provider merchant access denied"
          },
          "404": {
            "description": "Dispute not found"
          },
          "409": {
            "description": "Stale review, competing operation, or uncertain provider outcome"
          },
          "413": {
            "description": "Request exceeds 8 KiB"
          },
          "415": {
            "description": "JSON content type required"
          },
          "422": {
            "description": "Deadline, draft, or evidence policy failed"
          }
        },
        "security": [
          {
            "merchantSession": []
          }
        ]
      },
      "get": {
        "summary": "Review a server-owned action or inspect its existing operation",
        "security": [
          {
            "merchantSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "PROVIDE_EVIDENCE",
                "ACCEPT_CLAIM"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review snapshot, snapshot_digest, and optional operation state"
          },
          "400": {
            "description": "Missing or invalid action"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "PayPal belongs to another merchant"
          },
          "404": {
            "description": "Dispute not found"
          },
          "409": {
            "description": "Dispute is not actionable or a legacy approval needs reconciliation"
          },
          "422": {
            "description": "Deadline, draft, or evidence policy failed"
          }
        }
      }
    },
    "/api/disputes/{id}/packet": {
      "get": {
        "summary": "Download generated PDF evidence packet compiled from cryptographic vault",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Binary PDF document with evidence hashes and delivery proof",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/paypal": {
      "post": {
        "summary": "Verify and durably receive PayPal events, then atomically project business state",
        "responses": {
          "200": {
            "description": "Event committed, explicitly ignored, or already completed"
          },
          "401": {
            "description": "Invalid signature or missing verification headers"
          },
          "400": {
            "description": "Malformed JSON or invalid event envelope"
          },
          "409": {
            "description": "Event ID was already received with different content"
          },
          "413": {
            "description": "Webhook body exceeds 256 KiB"
          },
          "415": {
            "description": "JSON content type required"
          },
          "422": {
            "description": "Verified event requires dead-letter review"
          },
          "503": {
            "description": "Demo mode, configuration mismatch/unavailable integration, verification outage, or durable retry/dependency pending"
          }
        }
      }
    },
    "/api/trust-lab/run": {
      "post": {
        "summary": "Run 6 penetration test vectors against the live defense pipeline",
        "responses": {
          "200": {
            "description": "All 6 attacks executed and confirmed blocked"
          },
          "403": {
            "description": "Simulation is disabled outside demo mode"
          }
        }
      }
    },
    "/api/bench/run": {
      "post": {
        "summary": "Execute 40-scenario dispute benchmark harness and record results",
        "responses": {
          "200": {
            "description": "Benchmark metrics summary"
          },
          "403": {
            "description": "Simulation is disabled outside demo mode"
          }
        }
      }
    },
    "/api/disputes/{id}/regenerate-draft": {
      "post": {
        "summary": "Create a new cited draft from current stored evidence without submitting a provider action",
        "security": [
          {
            "merchantSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New draft returned as {draft}; verification may be false if evidence is insufficient"
          },
          "400": {
            "description": "Malformed body or unsupported fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin denied"
          },
          "404": {
            "description": "Dispute not found"
          },
          "409": {
            "description": "Dispute no longer awaits action or an approval already exists"
          },
          "413": {
            "description": "Request exceeds 8 KiB"
          },
          "415": {
            "description": "JSON content type required"
          }
        }
      }
    },
    "/api/runtime": {
      "get": {
        "summary": "Read the server-selected environment and simulation capability",
        "security": [
          {
            "merchantSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Runtime configuration; mode cannot be selected by the client",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mode",
                    "simulation_enabled",
                    "provider_environment"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "demo",
                        "sandbox",
                        "live"
                      ]
                    },
                    "simulation_enabled": {
                      "type": "boolean"
                    },
                    "provider_environment": {
                      "enum": [
                        null,
                        "sandbox",
                        "live"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Session required"
          }
        }
      }
    },
    "/api/storefront/checkout": {
      "post": {
        "summary": "Create a simulated order in demo mode only",
        "security": [
          {
            "merchantSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Simulation result"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Simulation disabled outside demo mode or Origin denied"
          }
        }
      }
    },
    "/api/carrier/update": {
      "post": {
        "summary": "Advance simulated carrier evidence in demo mode only",
        "security": [
          {
            "merchantSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Simulation result"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Simulation disabled outside demo mode or Origin denied"
          }
        }
      }
    },
    "/api/disputes/{id}/reconcile": {
      "get": {
        "summary": "Read operation details and recent reconciliation history",
        "security": [
          {
            "merchantSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation, observations, and retry_allowed false"
          },
          "401": {
            "description": "Session required"
          },
          "404": {
            "description": "Dispute not found"
          },
          "409": {
            "description": "No approval operation"
          }
        }
      },
      "post": {
        "summary": "Observe provider state without retrying an action",
        "security": [
          {
            "merchantSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0,
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Observation recorded; retry_allowed remains false"
          },
          "400": {
            "description": "Malformed body or attempted override"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin or merchant integration denied"
          },
          "404": {
            "description": "Dispute not found"
          },
          "409": {
            "description": "Demo mode, active/completed/missing operation, or lease conflict"
          },
          "413": {
            "description": "Body exceeds 8 KiB"
          },
          "415": {
            "description": "JSON required"
          },
          "422": {
            "description": "Provenance or operation mismatch"
          },
          "429": {
            "description": "30-second cooldown"
          },
          "502": {
            "description": "Provider lookup or resource validation failed; ERROR recorded"
          },
          "503": {
            "description": "Provider configuration unavailable or mismatched"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "merchantSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dispute_session"
      }
    }
  }
}
