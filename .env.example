# ==============================================================================
# Dispute Autopilot - Environment Configuration
# Built for PayPal AI Hackathon 2026
#
# NOTE: Never commit sensitive credentials or live secrets to Git.
# ==============================================================================

# Application environment: demo (offline), sandbox, or live.
# Operational modes require matching PAYPAL_ENVIRONMENT and credentials.
APP_MODE=demo

# PayPal Sandbox REST API Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
# Account ID returned by GET /api/auth; owns the configured PayPal integration.
PAYPAL_MERCHANT_USER_ID=

# AI Agent Provider (Optional: Defaults to internal deterministic cited engine if keys not set)
AI_MODEL_NAME=DisputeAutopilot-Agent-v1
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Database Configuration
PORT=3000
NODE_ENV=development
# Required in production. Must match the browser's exact public origin (HTTPS).
APP_ORIGIN=http://localhost:3000
# Optional persistent directory for auth.db and environments/<mode>/merchants/<account-id>.db
# DATA_DIR=/absolute/path/to/persistent/data
