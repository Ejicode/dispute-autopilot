#!/usr/bin/env bash
# ==============================================================================
# Dispute Autopilot - 1-Click Startup Script
# Built for PayPal AI Hackathon 2026
# ==============================================================================
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT_DIR}"

# ANSI Colors
BOLD="\033[1m"
GREEN="\033[0;32m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
YELLOW="\033[1;33m"
RESET="\033[0m"

echo -e "${BLUE}${BOLD}"
cat << "BANNER"
  ____  _                 _         _         _              _ _       _   
 |  _ \(_)___ _ __  _   _| |_ ___  / \  _   _| |_ ___  _ __ (_) | ___ | |_ 
 | | | | / __| '_ \| | | | __/ _ \/ _ \| | | | __/ _ \| '_ \| | |/ _ \| __|
 | |_| | \__ \ |_) | |_| | ||  __/ ___ \ |_| | || (_) | |_) | | | (_) | |_ 
 |____/|_|___/ .__/ \__,_|\__\___/_/   \_\__,_|\__\___/| .__/|_|_|\___/ \__|
             |_|                                       |_|                  
BANNER
echo -e "${RESET}"
echo -e "${CYAN}${BOLD}  Enterprise Edition | Autonomous Dispute Defense${RESET}"
echo -e "${BLUE}  ----------------------------------------------------------------------${RESET}\n"

# 1. Check Go
if ! command -v go >/dev/null 2>&1; then
  echo -e "${YELLOW}[!] Go is not installed or not in PATH.${RESET}"
  echo "    Please install Go 1.26+ (required by go.mod) from https://go.dev/dl/"
  exit 1
fi

# 2. Check & Initialize .env.local
if [ ! -f .env.local ]; then
  echo -e "${CYAN}[*] Initializing .env.local from .env.example...${RESET}"
  cp .env.example .env.local
  echo -e "${GREEN}[✓] .env.local created (Default: APP_MODE=demo).${RESET}"
fi

# 3. Check / Build Frontend Static Assets
if [ ! -f out/index.html ]; then
  echo -e "${CYAN}[*] Static web assets not found in ./out. Building frontend...${RESET}"
  if ! command -v npm >/dev/null 2>&1; then
    echo -e "${YELLOW}[!] npm not found. Node.js 20+ is required to build the frontend.${RESET}"
    exit 1
  fi
  npm ci
  npm run build
  echo -e "${GREEN}[✓] Frontend built successfully.${RESET}"
fi

# 4. Check / Compile Go Server Binary
if [ ! -f bin/server ]; then
  echo -e "${CYAN}[*] Compiling Go server binary into ./bin/server...${RESET}"
  mkdir -p bin
  go build -o bin/server ./cmd/server
  echo -e "${GREEN}[✓] Binary compiled successfully.${RESET}"
fi

PORT="${PORT:-3000}"

echo -e "${GREEN}${BOLD}✓ Dispute Autopilot is ready!${RESET}"
echo -e "  ➜ Local URL:       ${CYAN}${BOLD}http://localhost:${PORT}${RESET}"
echo -e "  ➜ Mode:            ${GREEN}Offline Demo${RESET} (Realtime simulated sandbox)"
echo -e "  ➜ AI Provider:     ${CYAN}Ava AI Autonomous Defense Engine${RESET}"
echo -e "  ➜ Security Suite:  ${GREEN}6/6 Penetration Attack Vectors Active${RESET}"
echo -e "  ➜ Press ${BOLD}Ctrl+C${RESET} to gracefully stop the server.\n"

# Execute compiled server binary
exec ./bin/server
